DROP TABLE IF EXISTS t1, t2;
CREATE TABLE t1 (
member VARBINARY(255) NOT NULL,
score  DOUBLE NOT NULL,
PRIMARY KEY (member),
KEY idx_score (score, member)
) ENGINE=ZSET;
CREATE TABLE t2 (
member VARBINARY(255) NOT NULL,
score  DOUBLE NOT NULL,
PRIMARY KEY (member),
KEY idx_score (score, member)
) ENGINE=ZSET;
INSERT INTO t1 VALUES ('a', 1), ('b', 2), ('c', 1), ('d', 3), ('e', 2), ('f', 1);
INSERT INTO t2 VALUES ('a', 10), ('b', 20), ('z', 99);
SELECT score, COUNT(*), SUM(score), AVG(score), MIN(score), MAX(score)
FROM t1 GROUP BY score ORDER BY score;
score	COUNT(*)	SUM(score)	AVG(score)	MIN(score)	MAX(score)
1	3	3	1	1	1
2	2	4	2	2	2
3	1	3	3	3	3
SELECT score, COUNT(*) FROM t1 GROUP BY score HAVING COUNT(*) >= 2 ORDER BY score;
score	COUNT(*)
1	3
2	2
SELECT t1.member, t1.score, t2.score FROM t1 JOIN t2 ON t1.member = t2.member
ORDER BY t1.member;
member	score	score
a	1	10
b	2	20
SELECT t1.member, t2.score FROM t1 LEFT JOIN t2 ON t1.member = t2.member
ORDER BY t1.member;
member	score
a	10
b	20
c	NULL
d	NULL
e	NULL
f	NULL
