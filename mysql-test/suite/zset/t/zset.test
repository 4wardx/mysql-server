#
# ZSET storage engine test.
#
# Covers create/insert/select/update/delete/range/truncate/drop and
# schema validation. The engine is loaded as a plugin via zset.opt.
#

--disable_warnings
DROP TABLE IF EXISTS t1, t2;
--enable_warnings

# The ZSET engine must be registered.
SELECT ENGINE FROM information_schema.ENGINES WHERE ENGINE='ZSET';

# Create the fixed-schema ZSET table.
CREATE TABLE t1 (
  member VARBINARY(255) NOT NULL,
  score  DOUBLE NOT NULL,
  PRIMARY KEY (member),
  KEY idx_score (score, member)
) ENGINE=ZSET;

# Insert rows with duplicate scores.
INSERT INTO t1 VALUES ('apple', 3), ('banana', 1), ('cherry', 1),
                      ('egg', 1), ('durian', 2.5);

# Ordered scan along (score, member).
SELECT member, score FROM t1 ORDER BY score, member;

# PK point lookup (ZSCORE equivalent).
SELECT score FROM t1 WHERE member = 'apple';

# Score range (ZRANGEBYSCORE equivalent).
SELECT member FROM t1 WHERE score BETWEEN 1 AND 1 ORDER BY score, member;

# Reverse order (ZREVRANGE equivalent).
SELECT member FROM t1 ORDER BY score DESC LIMIT 1;

# Update score.
UPDATE t1 SET score = 0.5 WHERE member = 'apple';
SELECT score FROM t1 WHERE member = 'apple';

# Delete by score range.
DELETE FROM t1 WHERE score = 1;
SELECT COUNT(*) FROM t1;

# Duplicate member must be rejected.
--error 1062
INSERT INTO t1 VALUES ('durian', 9);

# Illegal schema must be rejected.
--error ER_ILLEGAL_HA
CREATE TABLE t2 (a INT) ENGINE=ZSET;

# Truncate and drop.
TRUNCATE TABLE t1;
SELECT COUNT(*) FROM t1;
DROP TABLE t1;

#
# Additional edge cases.
#

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (
  member VARBINARY(255) NOT NULL,
  score  DOUBLE NOT NULL,
  PRIMARY KEY (member),
  KEY idx_score (score, member)
) ENGINE=ZSET;

# Empty-table operations.
SELECT COUNT(*) FROM t1;
SELECT member FROM t1 ORDER BY score, member;
DELETE FROM t1 WHERE score = 1;
DELETE FROM t1 WHERE member = 'x';

INSERT INTO t1 VALUES ('a', 1), ('b', 2), ('c', 3), ('d', 4), ('e', 5);

# Full reverse ordered scan (index_last / index_prev path).
SELECT member FROM t1 ORDER BY score DESC;

# Single-row delete by primary key.
DELETE FROM t1 WHERE member = 'b';
SELECT COUNT(*) FROM t1;

# Update that changes the primary key (delete old + insert new).
UPDATE t1 SET member = 'bb', score = 2 WHERE member = 'a';
SELECT member FROM t1 WHERE score = 2;

# REPLACE uses delete + insert on the primary key.
REPLACE INTO t1 VALUES ('c', 30);
SELECT score FROM t1 WHERE member = 'c';
SELECT COUNT(*) FROM t1;

# Non-idempotent full-table update: score=score+10 must apply exactly
# once. Before snapshot scans, the new versions re-sorted after the scan
# cursor and the UPDATE re-applied forever.
UPDATE t1 SET score = score + 10;
SELECT member, score FROM t1 ORDER BY score, member;

# Filesort forces position/rnd_pos based reads.
SELECT member FROM t1 ORDER BY member;

DROP TABLE t1;

#
# Snapshot scans, index-path updates and score ordering edge cases.
#

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (
  member VARBINARY(255) NOT NULL,
  score  DOUBLE NOT NULL,
  PRIMARY KEY (member),
  KEY idx_score (score, member)
) ENGINE=ZSET;

# Negative and fractional scores sort correctly.
INSERT INTO t1 VALUES ('a', -5), ('b', 0), ('c', 2.5), ('d', -0.5), ('e', 10);
SELECT member, score FROM t1 ORDER BY score, member;

# Index-path range update: score=score+10 applies exactly once to the rows
# in the range (the snapshot fix covers index scans too).
UPDATE t1 SET score = score + 10 WHERE score BETWEEN -1 AND 3;
SELECT member, score FROM t1 ORDER BY score, member;

# Index-path range delete.
DELETE FROM t1 WHERE score >= 15;
SELECT COUNT(*) FROM t1;

# Two full-table updates in separate statements stack correctly (each
# statement gets a fresh scan snapshot).
UPDATE t1 SET score = score + 1;
UPDATE t1 SET score = score + 1;
SELECT member, score FROM t1 ORDER BY score, member;

# Update that reorders rows: raise a low member past the highest one.
UPDATE t1 SET score = 100 WHERE member = 'a';
SELECT member, score FROM t1 ORDER BY score, member;

# Reverse order via idx_score.
SELECT member, score FROM t1 ORDER BY score DESC;

# Filesort on member with tied scores.
INSERT INTO t1 VALUES ('x', 5), ('y', 5), ('z', 5);
SELECT member, score FROM t1 ORDER BY member;

# REPLACE changes the key and the score together.
REPLACE INTO t1 VALUES ('b', 50);
SELECT member, score FROM t1 WHERE member = 'b';

# Boundary checks on the score range.
SELECT COUNT(*) FROM t1 WHERE score <= 5;
SELECT COUNT(*) FROM t1 WHERE score > 5;

# One statement changes both the primary key and the score.
UPDATE t1 SET member = 'b2', score = score + 1 WHERE member = 'b';
SELECT member, score FROM t1 WHERE member IN ('b', 'b2');

# LIMIT over an ordered range.
SELECT member FROM t1 ORDER BY score, member LIMIT 2;

DROP TABLE t1;

#
# Complex SQL: aggregates, GROUP BY / HAVING, joins, subqueries.
# These read through the handler, so they exercise rnd/index scans,
# position/rnd_pos re-reads and temp-table interaction.
#

--disable_warnings
DROP TABLE IF EXISTS t1, t2;
--enable_warnings

CREATE TABLE t1 (
  member VARBINARY(255) NOT NULL,
  score  DOUBLE NOT NULL,
  PRIMARY KEY (member),
  KEY idx_score (score, member)
) ENGINE=ZSET;

CREATE TABLE t2 (
  member VARBINARY(255) NOT NULL,
  score  DOUBLE NOT NULL,
  PRIMARY KEY (member),
  KEY idx_score (score, member)
) ENGINE=ZSET;

INSERT INTO t1 VALUES ('a', 1), ('b', 2), ('c', 1), ('d', 3), ('e', 2), ('f', 1);
INSERT INTO t2 VALUES ('a', 10), ('b', 20), ('z', 99);

# Aggregates grouped by score.
SELECT score, COUNT(*), SUM(score), AVG(score), MIN(score), MAX(score)
FROM t1 GROUP BY score ORDER BY score;

# HAVING filters the groups.
SELECT score, COUNT(*) FROM t1 GROUP BY score HAVING COUNT(*) >= 2 ORDER BY score;

# Inner join on the primary key.
SELECT t1.member, t1.score, t2.score FROM t1 JOIN t2 ON t1.member = t2.member
ORDER BY t1.member;

# Left join leaves the unmatched rows NULL.
SELECT t1.member, t2.score FROM t1 LEFT JOIN t2 ON t1.member = t2.member
ORDER BY t1.member;

# IN subquery.
SELECT member FROM t1 WHERE member IN (SELECT member FROM t2) ORDER BY member;

# EXISTS subquery.
SELECT member FROM t1 WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.member = t1.member)
ORDER BY member;

# DISTINCT over the score column.
SELECT DISTINCT score FROM t1 ORDER BY score;

# UNION of both tables.
SELECT member FROM t1 UNION SELECT member FROM t2 ORDER BY member;

DROP TABLE t1, t2;

#
# UPDATE on a flushed (sstable-backed) table.
#
# A full-table UPDATE writes new versions while its scan is open. Two
# bugs lived here: update_row did one merged point scan per row (O(N^2)
# on flushed rows), and a mid-scan flush freed the memtable nodes the
# scan cursor was walking. A small zset_memtable_limit flushes the rows
# into an sstable without loading 100K rows.
#

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

# The memtable limit is tunable; drop it so a flush happens after 1000
# keys and the rest of the rows stay in the memtable.
SET GLOBAL zset_memtable_limit = 1000;

CREATE TABLE t1 (
  member VARBINARY(255) NOT NULL,
  score  DOUBLE NOT NULL,
  PRIMARY KEY (member),
  KEY idx_score (score, member)
) ENGINE=ZSET;

SET SESSION cte_max_recursion_depth = 2000;
INSERT INTO t1 (member, score)
  WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM s WHERE n < 1005)
  SELECT CONCAT('m_', LPAD(n, 4, '0')), n FROM s;

# 1005 rows: one flush at the limit, the rest in the memtable.
SELECT COUNT(*) FROM t1;

# Full-table decrease then increase: every row is updated exactly once
# and the scores round-trip.
UPDATE t1 SET score = score - 10;
SELECT COUNT(*) FROM t1;
SELECT member, score FROM t1
  WHERE member IN ('m_0001', 'm_1001', 'm_1005')
  ORDER BY member;

UPDATE t1 SET score = score + 10;
SELECT member, score FROM t1
  WHERE member IN ('m_0001', 'm_1001', 'm_1005')
  ORDER BY member;

# Index-path range update on flushed rows.
UPDATE t1 SET score = score * 2 WHERE score BETWEEN 10 AND 12;
SELECT member, score FROM t1
  WHERE member IN ('m_0010', 'm_0011', 'm_0012')
  ORDER BY member;

# Aggregate over the updated flushed table.
SELECT COUNT(*), MIN(score), MAX(score) FROM t1;

DROP TABLE t1;
SET GLOBAL zset_memtable_limit = 100000;
